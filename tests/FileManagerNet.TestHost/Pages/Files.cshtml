@page
@using FileManagerNet.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, FileManagerNet
@{
    Layout = null;
    var root = Environment.GetEnvironmentVariable("FMNET_TEST_ROOT") ?? "";
    var locale = Request.Query["locale"].ToString();
    var view = Request.Query["view"].ToString();
    var cfg = new FileManagerConfig { MaxUploadBytes = 0 };
    if (!string.IsNullOrEmpty(view) && Enum.TryParse<ViewLayout>(view, out var parsed))
        cfg.DefaultView = parsed;
    if (Request.Query["nosearch"].ToString() == "1") cfg.AllowSearch = false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FileManagerNet test host</title>
    <style>html, body { margin: 0; height: 100%; } .host { height: 100%; }</style>
</head>
<body>
<div class="host">
    <file-manager id="FM"
                  root-folder="@root"
                  root-name="Test"
                  api-endpoint="/filemanager-api"
                  config="cfg"
                  locale="@locale" />
</div>
</body>
</html>
