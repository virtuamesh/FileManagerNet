@page
@using FileManagerNet.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, FileManagerNet
@{
    Layout = null;
    var root = Environment.GetEnvironmentVariable("FMNET_TEST_ROOT") ?? "";
    var cfg = new FileManagerConfig { MaxUploadBytes = 0 };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FileManagerNet ACL test host</title>
    <style>html, body { margin: 0; height: 100%; } .host { height: 100%; }</style>
</head>
<body>
<div class="host">
    <file-manager id="FM_ACL"
                  root-folder="@System.IO.Path.Combine(root, "_acl")"
                  root-name="ACL"
                  api-endpoint="/filemanager-api"
                  config="cfg" />
</div>
</body>
</html>
