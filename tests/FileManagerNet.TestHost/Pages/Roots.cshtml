@page
@using FileManagerNet.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, FileManagerNet
@{
    Layout = null;
    var root1 = Environment.GetEnvironmentVariable("FMNET_TEST_ROOT") ?? "";
    var root2 = Environment.GetEnvironmentVariable("FMNET_TEST_ROOT2") ?? root1;
    var cfg = new FileManagerConfig { MaxUploadBytes = 0 };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>several root folders</title>
    <style>html, body { margin: 0; height: 100%; } .host { height: 100%; }</style>
</head>
<body>
<div class="host">
    <file-manager id="FM_ROOTS"
                  root-folder="First=@root1;Second=@root2"
                  root-name="Mounts"
                  api-endpoint="/filemanager-api"
                  config="cfg" />
</div>
</body>
</html>
