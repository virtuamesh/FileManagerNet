<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FileManagerNet.E2ETests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- the host is started as a child process, so it must be built first -->
  <ItemGroup>
    <ProjectReference Include="..\FileManagerNet.TestHost\FileManagerNet.TestHost.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- remember where the host's own output lives (it keeps its static-asset
       manifest there, so it must be run from that folder, not from ours) -->
  <Target Name="WriteTestHostPath" AfterTargets="Build">
    <WriteLinesToFile
      File="$(OutDir)testhost-path.txt"
      Lines="$(MSBuildThisFileDirectory)..\FileManagerNet.TestHost\bin\$(Configuration)\net10.0"
      Overwrite="true" />
  </Target>

</Project>
