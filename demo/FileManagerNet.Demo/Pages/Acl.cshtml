@page
@using FileManagerNet.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, FileManagerNet
@{
    var fmConfig = new FileManagerConfig
    {
        DefaultView = ViewLayout.Details,
        MaxUploadBytes = 0,
    };
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FileManagerNet — 权限（ACL）演示</title>
    <style>
        html, body { margin: 0; padding: 0; height: 100%; font-family: "Segoe UI", system-ui, sans-serif; background: #f3f4f6; }
        .page { display: flex; flex-direction: column; height: 100%; }
        .page-header { padding: 12px 20px; background: #1e293b; color: #fff; }
        .page-header h1 { margin: 0; font-size: 17px; font-weight: 600; }
        .page-header p { margin: 5px 0 0; font-size: 12px; color: #94a3b8; }
        .page-header a { color: #7dd3fc; text-decoration: none; margin-right: 12px; }
        .page-header code { color: #fcd34d; }
        .page-main { flex: 1; padding: 14px 16px 16px; box-sizing: border-box; min-height: 0; }
        .fm-host { height: 100%; }
    </style>
</head>
<body>
<div class="page">
    <div class="page-header">
        <h1>FileManagerNet — 权限（ACL）演示</h1>
        <p>
            整棵树只读；<code>/public</code> 可写（新增、上传、删除、改名、粘贴）；
            <code>/public/images</code> 只收图片且限 5 MB；<code>/secret</code> 拒绝访问。
        </p>
        <p><a href="/">返回首页</a><a href="/Roots">多根目录</a><a href="/Multi">双实例</a></p>
    </div>
    <div class="page-main">
        <div class="fm-host">
            <file-manager id="FM_ACL"
                          root-folder='D:\测试文档\_acl-demo'
                          root-name="ACL 演示"
                          config="fmConfig"
                          api-endpoint="/filemanager-api" />
        </div>
    </div>
</div>
</body>
</html>
