@page
@using FileManagerNet.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, FileManagerNet
@{
    // Office online preview: documents are converted to PDF by LibreOffice.
    // Leave LibreOfficePath empty to auto-detect the usual install location.
    var fmConfig = new FileManagerConfig
    {
        OfficePreviewEnabled = true,
        // LibreOfficePath = @"C:\Program Files\LibreOffice\program\soffice.exe",
        OfficeConvertTimeoutSeconds = 60,
        OfficeCacheMinutes = 1440
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FileManagerNet Demo</title>
    <style>
        html, body { margin: 0; padding: 0; height: 100%; font-family: "Segoe UI", system-ui, sans-serif; background: #f3f4f6; }
        .page { display: flex; flex-direction: column; height: 100%; }
        .page-header { padding: 14px 20px; background: #1e293b; color: #fff; }
        .page-header h1 { margin: 0; font-size: 18px; font-weight: 600; }
        .page-header p { margin: 4px 0 0; font-size: 12px; color: #94a3b8; }
        .page-header a { color: #7dd3fc; text-decoration: none; margin-right: 12px; }
        .page-main { flex: 1; padding: 16px; box-sizing: border-box; min-height: 0; }
        .fm-host { height: 100%; }
    </style>
</head>
<body>
<div class="page">
    <div class="page-header">
        <h1>FileManagerNet — Demo</h1>
        <p>Open-source (MIT) Windows-Explorer-style file manager for ASP.NET Core 10. Vanilla JS, no jQuery.</p>
        <p><a href="/Roots">单目录 / 多目录根</a><a href="/Multi">同一页面两个实例</a><a href="/Acl">权限（ACL）</a></p>
    </div>
    <div class="page-main">
        <div class="fm-host">
            <file-manager id="FM1"
                          root-folder='E:\'
                          root-name="本地磁盘 (E:)"
                          config="fmConfig"
                          api-endpoint="/filemanager-api" />
        </div>
    </div>
</div>
</body>
</html>
