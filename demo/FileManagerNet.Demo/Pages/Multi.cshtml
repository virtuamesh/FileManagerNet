@page
@using FileManagerNet.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, FileManagerNet
@inject IWebHostEnvironment Env
@{
    var leftCfg = new FileManagerConfig { DefaultView = ViewLayout.Details };
    var rightCfg = new FileManagerConfig { DefaultView = ViewLayout.LargeIcons };
    var demoRoot = System.IO.Path.Combine(Env.ContentRootPath, "App_Data", "demo-files");
    var leftRoot = System.IO.Directory.Exists(@"D:\测试文档") ? @"D:\测试文档" : demoRoot;
    var rightRoot = System.IO.Directory.Exists(@"D:\测试文档\文档") ? @"D:\测试文档\文档" : leftRoot;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FileManagerNet — 多目录示例</title>
    <style>
        html, body { margin: 0; height: 100%; font-family: "Segoe UI", system-ui, sans-serif; background: #f3f4f6; }
        .page { display: flex; flex-direction: column; height: 100%; }
        .page-header { padding: 10px 16px; background: #1e293b; color: #fff; }
        .page-header h1 { margin: 0; font-size: 15px; font-weight: 600; }
        .page-header p { margin: 3px 0 0; font-size: 12px; color: #94a3b8; }
        .split { flex: 1; display: flex; gap: 10px; padding: 10px; box-sizing: border-box; min-height: 0; }
        .split > section { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; }
        @@media (max-width: 900px) {
            .split { flex-direction: column; }
            .split > section { flex: 1 1 0; min-height: 0; }
        }
    </style>
</head>
<body>
<div class="page">
    <div class="page-header">
        <h1>多目录示例 — 同一页面两个独立实例</h1>
        <p>左边「测试文档」、右边「文档」。选择、剪贴板、视图、排序彼此独立；键盘快捷键只作用于最后点击的那个实例。</p>
    </div>
    <div class="split">
        <section>
            <file-manager id="FM_LEFT"
                          root-folder="@leftRoot"
                          root-name="测试文档"
                          api-endpoint="/filemanager-api"
                          config="leftCfg" />
        </section>
        <section>
            <file-manager id="FM_RIGHT"
                          root-folder="@rightRoot"
                          root-name="文档"
                          api-endpoint="/filemanager-api"
                          config="rightCfg" />
        </section>
    </div>
</div>
</body>
</html>
