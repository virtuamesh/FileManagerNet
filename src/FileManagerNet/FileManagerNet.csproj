<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FileManagerNet</RootNamespace>
    <PackageId>FileManagerNet</PackageId>
    <Authors>FileManagerNet Contributors</Authors>
    <Description>A free, open-source (MIT) Windows-Explorer-style file manager control for ASP.NET Core 10. Vanilla JS front-end, no jQuery.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>filemanager;file-explorer;aspnetcore;taghelper;file-upload;file-download</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

</Project>
